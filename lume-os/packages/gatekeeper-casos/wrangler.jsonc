{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-casos",
  "main": ".wrangler/validate/src/worker.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src",
  },
  "compatibility_date": "2026-02-02",
  // The Workshop stores the account capability createAccount() mints.
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],
  // Both Durable Objects are reached through ctx.exports; no binding is required.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CaseRegistry", "CasosGatekeeper"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DocumentVault"],
    },
  ],
  // The Cofre's files. The starter's deploy provisions the bucket (or binds resources.cofreBucket)
  // and adds the Workers AI binding, which local development runs without.
  "r2_buckets": [{ "binding": "COFRE", "bucket_name": "lume-cofre-dev" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
  },
}
